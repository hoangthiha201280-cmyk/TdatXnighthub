local Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/SiLeNTxXx/Rayfield/main/source'))()

local Window = Rayfield:CreateWindow({
    Name = "Tien Dat X Hub",
    LoadingTitle = "Tien Dat X Hub",
    LoadingSubtitle = "by Tien Dat",
    ConfigurationSaving = { Enabled = false },
    Discord = { Enabled = false },
    KeySystem = false
})

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHumanoid()
    local char = getChar()
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local char = getChar()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local PlayerTab = Window:CreateTab("Player", 4483362458)
local AimTab = Window:CreateTab("Aim", 4483362458)
local VisualTab = Window:CreateTab("Visual", 4483362458)

local SpeedValue = 16
local JumpValue = 50
local FlyEnabled = false
local NoclipEnabled = false
local AimEnabled = false
local FlyKeys = {W = false, A = false, S = false, D = false, Space = false, LeftShift = false}
local FlyBV = nil
local FlyBG = nil

PlayerTab:CreateSlider({
    Name = "Speed",
    Range = {20, 500},
    Increment = 1,
    Suffix = "WalkSpeed",
    CurrentValue = 16,
    Flag = "SpeedSlider",
    Callback = function(Value)
        SpeedValue = Value
        local h = getHumanoid()
        if h then h.WalkSpeed = Value end
    end
})

PlayerTab:CreateSlider({
    Name = "Jump",
    Range = {50, 500},
    Increment = 1,
    Suffix = "JumpPower",
    CurrentValue = 50,
    Flag = "JumpSlider",
    Callback = function(Value)
        JumpValue = Value
        local h = getHumanoid()
        if h then h.JumpPower = Value end
    end
})

PlayerTab:CreateToggle({
    Name = "Fly",
    CurrentValue = false,
    Flag = "FlyToggle",
    Callback = function(Value)
        FlyEnabled = Value
        if FlyEnabled then
            local root = getRoot()
            local h = getHumanoid()
            if root and h then
                FlyBV = Instance.new("BodyVelocity")
                FlyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                FlyBV.Velocity = Vector3.new(0, 0, 0)
                FlyBV.Parent = root
                FlyBG = Instance.new("BodyGyro")
                FlyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
                FlyBG.D = 100
                FlyBG.P = 9000
                FlyBG.Parent = root
                h.PlatformStand = true
            end
        else
            if FlyBV then FlyBV:Destroy() FlyBV = nil end
            if FlyBG then FlyBG:Destroy() FlyBG = nil end
            local h = getHumanoid()
            if h then h.PlatformStand = false end
        end
    end
})

PlayerTab:CreateToggle({
    Name = "Noclip",
    CurrentValue = false,
    Flag = "NoclipToggle",
    Callback = function(Value)
        NoclipEnabled = Value
        local char = getChar()
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = not Value end
            end
        end
    end
})

AimTab:CreateToggle({
    Name = "Aim",
    CurrentValue = false,
    Flag = "AimToggle",
    Callback = function(Value) AimEnabled = Value end
})

VisualTab:CreateLabel("Menu Rayfield hoat dong!")

RunService.RenderStepped:Connect(function()
    if FlyEnabled and FlyBV and FlyBG then
        local root = getRoot()
        if root then
            local dir = Vector3.new(0, 0, 0)
            if FlyKeys.W then dir += Vector3.new(0, 0, -1) end
            if FlyKeys.S then dir += Vector3.new(0, 0, 1) end
            if FlyKeys.A then dir += Vector3.new(-1, 0, 0) end
            if FlyKeys.D then dir += Vector3.new(1, 0, 0) end
            if FlyKeys.Space then dir += Vector3.new(0, 1, 0) end
            if FlyKeys.LeftShift then dir += Vector3.new(0, -1, 0) end
            if dir.Magnitude > 0 then dir = dir.Unit end
            FlyBV.Velocity = dir * 50
            FlyBG.CFrame = Camera.CFrame
        end
    end
    if AimEnabled then
        local closest = nil
        local shortest = 100
        local root = getRoot()
        if root then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local char = player.Character
                    if char then
                        local h = char:FindFirstChildOfClass("Humanoid")
                        local r = char:FindFirstChild("HumanoidRootPart")
                        if h and h.Health > 0 and r then
                            local dist = (root.Position - r.Position).Magnitude
                            if dist < shortest then
                                shortest = dist
                                closest = r
                            end
                        end
                    end
                end
            end
            if closest then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, closest.Position)
            end
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if FlyEnabled then
        if input.KeyCode == Enum.KeyCode.W then FlyKeys.W = true end
        if input.KeyCode == Enum.KeyCode.A then FlyKeys.A = true end
        if input.KeyCode == Enum.KeyCode.S then FlyKeys.S = true end
        if input.KeyCode == Enum.KeyCode.D then FlyKeys.D = true end
        if input.KeyCode == Enum.KeyCode.Space then FlyKeys.Space = true end
        if input.KeyCode == Enum.KeyCode.LeftShift then FlyKeys.LeftShift = true end
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if FlyEnabled then
        if input.KeyCode == Enum.KeyCode.W then FlyKeys.W = false end
        if input.KeyCode == Enum.KeyCode.A then FlyKeys.A = false end
        if input.KeyCode == Enum.KeyCode.S then FlyKeys.S = false end
        if input.KeyCode == Enum.KeyCode.D then FlyKeys.D = false end
        if input.KeyCode == Enum.KeyCode.Space then FlyKeys.Space = false end
        if input.KeyCode == Enum.KeyCode.LeftShift then FlyKeys.LeftShift = false end
    end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    local humanoid = char:WaitForChild("Humanoid")
    humanoid.WalkSpeed = SpeedValue
    humanoid.JumpPower = JumpValue
end)
